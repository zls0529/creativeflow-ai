# Core — safe mock defaults
DATABASE_URL="file:./dev.db"
LLM_PROVIDER=mock
# OpenAI — server-side only; leave blank for mock mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=60000
# ComfyUI — optional local image provider
IMAGE_PROVIDER=mock
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT_NAME=
COMFYUI_STEPS=20
COMFYUI_CFG=7
COMFYUI_SAMPLER=euler
COMFYUI_SCHEDULER=normal
COMFYUI_TIMEOUT_MS=300000
# Vision — real review requires stored PNG output
VISION_PROVIDER=mock
# Real PNG review: set VISION_PROVIDER=openai; uses server OPENAI_API_KEY.
VISION_MODEL=gpt-4.1
CRITIC_THRESHOLD=80
MAX_REFINEMENTS=2

# Workflow — Creative Mode takes precedence for new routed campaigns
# Legacy workflow selection: basic | quality | sports | sports_pose | auto. auto detects dynamic human scenes.
COMFYUI_WORKFLOW_MODE=auto
# Quality settings are separate so existing basic settings remain unchanged.
COMFYUI_QUALITY_STEPS=28
COMFYUI_QUALITY_CFG=6
COMFYUI_QUALITY_SAMPLER=dpmpp_2m
COMFYUI_QUALITY_SCHEDULER=karras
COMFYUI_REFINE_STEPS=16
COMFYUI_REFINE_DENOISE=0.25
# Optional fixed seed for reproducible comparisons; empty uses a new random seed.
COMFYUI_SEED=

# Sports mode uses the existing checkpoint. auto selects it for dynamic human subjects.
COMFYUI_SPORTS_STEPS=32
COMFYUI_SPORTS_CFG=5.5
COMFYUI_SPORTS_SAMPLER=dpmpp_2m
COMFYUI_SPORTS_SCHEDULER=karras
COMFYUI_SPORTS_REFINE_STEPS=18
COMFYUI_SPORTS_REFINE_DENOISE=0.22
COMFYUI_SPORTS_FACE_DETAIL=true
COMFYUI_SPORTS_FACE_DETECTOR=bbox/face_yolov8m.pt
COMFYUI_SPORTS_FACE_STEPS=16
COMFYUI_SPORTS_FACE_DENOISE=0.22

# Optional SD1.5 pose conditioning; upload one campaign reference with role pose.
# COMFYUI_WORKFLOW_MODE=sports_pose (or auto)
COMFYUI_OPENPOSE_MODEL=control_v11p_sd15_openpose_fp16.safetensors
COMFYUI_POSE_STRENGTH=0.8
COMFYUI_POSE_START_PERCENT=0
COMFYUI_POSE_END_PERCENT=0.85

# Optional image reference conditioning (SD1.5 Plus + ViT-H; used only with product/style uploads).
COMFYUI_IPADAPTER_MODEL=ip-adapter-plus_sd15.safetensors
COMFYUI_CLIP_VISION_MODEL=CLIP-ViT-H-14-laion2B-s32B-b79_CLIP-ViT-H-14.safetensors

# Usage estimates only; blank disables limits/local monetization. USD.
MAX_CAMPAIGN_API_COST_USD=
MAX_JOB_API_COST_USD=
LOCAL_GPU_COST_PER_HOUR=
# Optional model-to-rates JSON; inputPerMillion, cachedInputPerMillion, outputPerMillion.
OPENAI_PRICING_JSON=

# Local masked repair only; existing generation workflows are unchanged.
COMFYUI_REPAIR_DENOISE=0.4
COMFYUI_REPAIR_STEPS=24
COMFYUI_REPAIR_CFG=5.5
COMFYUI_REPAIR_SAMPLER=dpmpp_2m
COMFYUI_REPAIR_SCHEDULER=karras

# Product Hero is selected per asset, not via COMFYUI_WORKFLOW_MODE.
# Must already be installed under ComfyUI models/sams; never auto-downloaded.
COMFYUI_PRODUCT_HERO_SAM_MODEL=sam_vit_b_01ec64.pth
# Optional installed RMBG-1.4 extraction (review BRIA commercial licence separately).
# Blank: alpha -> conservative neutral-background removal -> guided SAM.
# rmbg14: alpha -> installed RMBG -> neutral-background removal -> guided SAM.
COMFYUI_PRODUCT_HERO_REMBG=
# ComfyUI directory containing models/rembg/RMBG-1.4.pth; loopback server only.
# Used read-only to prevent the node downloading missing weights.
COMFYUI_LOCAL_ROOT=

# Explicit Commercial Poster selection only; existing COMFYUI_URL and auto stay unchanged.
# Official Klein core and the three pinned models must be installed on this endpoint.
COMFYUI_KLEIN_URL=http://127.0.0.1:8190
